# Secrets. The deployer key is also the protocol admin — never commit it.
.env
.env.*
!.env.example

# Build output
cache/
out/

# Foundry broadcast logs contain full tx history and sender addresses
broadcast/

# Address books are per-environment deploy artifacts, regenerated by Deploy.s.sol.
# Committing them invites stale addresses ending up in the wrong .env.
deployments/*.json
